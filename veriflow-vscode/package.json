{
  "name": "veriflow",
  "displayName": "Verilog Design Flow",
  "description": "Verilog design workflow for VS Code: analyze, compile, simulate, edit schematics, view waveforms, and generate testbenches",
  "icon": "media/icon.png",
  "version": "1.4.5",
  "publisher": "Vikai-mercer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "verilog",
    "systemverilog",
    "simulation",
    "testbench",
    "fpga",
    "rtl",
    "iverilog",
    "vcs",
    "waveform",
    "vcd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMercer12138/Vik-VeriFlow.git",
    "directory": "veriflow-vscode"
  },
  "activationEvents": [
    "workspaceContains:**/*.v",
    "workspaceContains:**/*.sv",
    "onCustomEditor:veriflow.waveformEditor",
    "onCustomEditor:veriflow.schematicEditor",
    "onCustomEditor:veriflow.archDesignEditor",
    "onView:veriflow.archDesigns",
    "onCommand:veriflow.createArchDesign"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "veriflow.waveformEditor",
        "displayName": "VeriFlow Waveform Viewer",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "veriflow.schematicEditor",
        "displayName": "VeriFlow Schematic Editor",
        "selector": [
          {
            "filenamePattern": "*.v"
          },
          {
            "filenamePattern": "*.sv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "veriflow.archDesignEditor",
        "displayName": "VeriFlow Arch Design Editor",
        "selector": [
          {
            "filenamePattern": "*.ad"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "arch-design",
        "aliases": [
          "Arch Design"
        ],
        "extensions": [
          ".ad"
        ]
      }
    ],
    "views": {
      "veriflow": [
        {
          "id": "veriflow.modules",
          "name": "Simulation",
          "icon": "$(circuit-board)",
          "contextualTitle": "Simulation"
        },
        {
          "id": "veriflow.archDesigns",
          "name": "Arch Designs",
          "icon": "$(type-hierarchy-sub)",
          "contextualTitle": "Arch Designs"
        },
        {
          "type": "webview",
          "id": "veriflow.testbench",
          "name": "Testbench Generator",
          "icon": "$(file-code)",
          "contextualTitle": "Testbench Generator"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "veriflow.archDesigns",
        "contents": "[Create Arch Design](command:veriflow.createArchDesign)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veriflow",
          "title": "VeriFlow",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "veriflow.selectTop",
        "title": "Select Top Module",
        "icon": "$(list-selection)"
      },
      {
        "command": "veriflow.analyze",
        "title": "Analyze Dependencies",
        "icon": "$(search)"
      },
      {
        "command": "veriflow.simulate",
        "title": "Compile & Simulate",
        "icon": "$(run)"
      },
      {
        "command": "veriflow.openWave",
        "title": "Open Waveform",
        "icon": "$(pulse)"
      },
      {
        "command": "veriflow.openVcdViewer",
        "title": "Open VCD in VeriFlow Viewer",
        "icon": "$(pulse)"
      },
      {
        "command": "veriflow.openSchematic",
        "title": "Open as VeriFlow Schematic",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.openSchematicFromExplorer",
        "title": "Open as VeriFlow Schematic",
        "category": "VeriFlow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "veriflow.scanModules",
        "title": "Scan Modules",
        "icon": "$(refresh)"
      },
      {
        "command": "veriflow.instantiateModule",
        "title": "Instantiate Module",
        "category": "VeriFlow",
        "icon": "$(symbol-method)"
      },
      {
        "command": "veriflow.showOutput",
        "title": "Show Output Panel",
        "icon": "$(output)"
      },
      {
        "command": "veriflow.createArchDesign",
        "title": "Create Arch Design",
        "category": "VeriFlow",
        "icon": "$(new-file)"
      },
      {
        "command": "veriflow.refreshArchDesigns",
        "title": "Refresh Arch Designs",
        "category": "VeriFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "veriflow.openArchDesign",
        "title": "Open Arch Design",
        "category": "VeriFlow",
        "icon": "$(go-to-file)"
      },
      {
        "command": "veriflow.validateArchDesign",
        "title": "Validate Arch Design",
        "category": "VeriFlow",
        "icon": "$(check)"
      },
      {
        "command": "veriflow.exportArchDesign",
        "title": "Export Arch Design RTL",
        "category": "VeriFlow",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "veriflow.instantiateModule",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "veriflow.openSchematicFromExplorer",
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "group": "navigation@9"
        },
        {
          "command": "veriflow.openVcdViewer",
          "when": "resourceExtname == .vcd",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "veriflow.openSchematic",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "veriflow.selectTop",
          "when": "view == veriflow.modules",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.analyze",
          "when": "view == veriflow.modules",
          "group": "navigation@2"
        },
        {
          "command": "veriflow.simulate",
          "when": "view == veriflow.modules",
          "group": "navigation@3"
        },
        {
          "command": "veriflow.openWave",
          "when": "view == veriflow.modules",
          "group": "navigation@4"
        },
        {
          "command": "veriflow.scanModules",
          "when": "view == veriflow.modules",
          "group": "navigation@5"
        },
        {
          "command": "veriflow.createArchDesign",
          "when": "view == veriflow.archDesigns",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.refreshArchDesigns",
          "when": "view == veriflow.archDesigns",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "veriflow.openArchDesign",
          "when": "view == veriflow.archDesigns && viewItem == archDesignFile",
          "group": "navigation@1"
        },
        {
          "command": "veriflow.validateArchDesign",
          "when": "view == veriflow.archDesigns && viewItem == archDesignFile",
          "group": "navigation@2"
        },
        {
          "command": "veriflow.exportArchDesign",
          "when": "view == veriflow.archDesigns && viewItem == archDesignFile",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "VeriFlow",
      "properties": {
        "veriflow.libDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Library directories for VeriFlow module search and dependency resolution"
        },
        "veriflow.defines": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "description": "SystemVerilog preprocessor defines used by VeriFlow structural parsing"
        },
        "veriflow.simulator": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ],
          "default": "builtin",
          "description": "Simulation backend. 'builtin' uses the bundled Icarus Verilog WebAssembly runtime for Verilog-2005; choose 'custom' for an external simulator."
        },
        "veriflow.simulatorCompileCmd": {
          "type": "string",
          "default": "",
          "description": "Custom compile command template. Use {files}, {output}, and {top_module}. Examples: Icarus Verilog: iverilog -g2005 -o \"{output}\" {files}; VCS: vcs -full64 -o \"{output}\" {files}; XSim: xvlog {files} && xelab {top_module} -snapshot \"{output}\"."
        },
        "veriflow.simulatorRunCmd": {
          "type": "string",
          "default": "",
          "description": "Custom run command template. Use {output}. Examples: Icarus Verilog: vvp \"{output}\"; VCS: ./\"{output}\"; XSim: xsim \"{output}\" --runall."
        },
        "veriflow.waveViewer": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ],
          "default": "builtin",
          "description": "Waveform viewer. 'builtin' opens VCD files in VeriFlow; choose 'custom' to launch an external viewer."
        },
        "veriflow.waveViewerCmd": {
          "type": "string",
          "default": "",
          "description": "Custom wave viewer command template. Use {wave_file}. Examples: Surfer: surfer \"{wave_file}\"; GTKWave: gtkwave \"{wave_file}\"."
        },
        "veriflow.waveFileTemplate": {
          "type": "string",
          "default": "{top_module}.vcd",
          "description": "Waveform file path template. Use {top_module} as placeholder."
        },
        "veriflow.testbenchOutputDir": {
          "type": "string",
          "default": ".",
          "description": "Directory where generated testbench files are written. Relative paths are resolved from the workspace root."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../scripts/build-vscode.mjs",
    "compile:ts": "tsc -p ./",
    "bundle": "node ./scripts/build.mjs",
    "compile": "npm run compile:ts && npm run bundle",
    "test": "npm run vscode:prepublish && node ./scripts/run-tests.mjs",
    "test:vsix": "npm run vscode:prepublish && node ./out/test/vsixPackaging.test.js",
    "test:schematic-integration": "npm run compile && node out/test/schematicIntegration.test.js",
    "test:task6": "npm run compile:ts && node out/test/core.test.js && node out/test/hdlFeatureMigration.test.js && node out/test/testbenchPanel.test.js",
    "watch": "node ../scripts/watch-vscode.mjs",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@antv/x6": "3.1.7",
    "@veriflow/flow-core": "1.4.5",
    "@veriflow/hdl-core": "1.4.5",
    "@veriflow/hdl-runtime": "1.4.5",
    "@veriflow/schematic-core": "1.4.5",
    "@veriflow/simulator-iverilog-wasm": "1.4.5",
    "@veriflow/waveform-runtime": "1.4.5",
    "lucide": "1.28.0",
    "web-tree-sitter": "0.26.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "tree-sitter-systemverilog": "0.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.66.0"
  }
}
