{
  "name": "@veriflow/cli",
  "version": "1.3.2",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "veriflow": "dist/main.js"
  },
  "files": ["dist"],
  "dependencies": {
    "@veriflow/flow-core": "1.3.2",
    "@veriflow/hdl-core": "1.3.2",
    "@veriflow/hdl-runtime": "1.3.2",
    "@veriflow/waveform-desktop": "1.3.2",
    "tree-sitter-systemverilog": "0.4.0",
    "web-tree-sitter": "0.26.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:shared --prefix ../.. && npm run build --workspace @veriflow/waveform-desktop",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  }
}
