{
  "name": "@veriflow/cli",
  "version": "1.3.2",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "veriflow": "dist/main.js"
  },
  "files": ["dist"],
  "dependencies": {
    "@veriflow/flow-core": "1.3.2",
    "@veriflow/hdl-core": "1.3.2",
    "@veriflow/hdl-runtime": "1.3.2",
    "tree-sitter-systemverilog": "0.4.0",
    "web-tree-sitter": "0.26.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:shared --prefix ../..",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  }
}
