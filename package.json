{
  "name": "veriflow-workspace",
  "private": true,
  "version": "1.3.2",
  "engines": {
    "node": "24.14.1"
  },
  "workspaces": [
    "packages/*",
    "veriflow-vscode"
  ],
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:parser": "node scripts/build-parser-probe.mjs",
    "build:vscode": "node scripts/build-vscode.mjs",
    "build:desktop": "npm run build --workspace @veriflow/waveform-desktop",
    "build:cli": "npm run build:desktop && npm run build --workspace @veriflow/cli",
    "build:shared": "npm run build --workspace @veriflow/flow-core --workspace @veriflow/hdl-core --workspace @veriflow/hdl-runtime --workspace @veriflow/waveform-runtime",
    "watch:vscode": "node scripts/watch-vscode.mjs",
    "build": "npm run build:web && npm run build:parser && npm run build:vscode",
    "typecheck:shared": "npm run typecheck --workspace @veriflow/flow-core --workspace @veriflow/hdl-core --workspace @veriflow/hdl-runtime --workspace @veriflow/waveform-runtime",
    "test:shared": "npm test --workspace @veriflow/flow-core --workspace @veriflow/hdl-core --workspace @veriflow/hdl-runtime --workspace @veriflow/waveform-runtime",
    "test:cli": "npm test --workspace @veriflow/cli",
    "test": "npm run test --workspaces --if-present",
    "verify:generated": "node scripts/verify-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "tree-sitter-systemverilog": "0.4.0",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.26.11"
  }
}
